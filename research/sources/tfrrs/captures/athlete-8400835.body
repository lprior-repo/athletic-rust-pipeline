<script>

    function seasonSelect(sel, target, newWindow) {
        var scope = document.getElementById('overall-bests') || document;
        var season = sel.options[sel.selectedIndex].value;
        var classes = ['outdoor_bests', 'indoor_bests', 'xc_bests', 'bests'];
        var showClass = season === 'xc' ? 'xc_bests'
                      : season === 'outdoor' ? 'outdoor_bests'
                      : season === 'indoor' ? 'indoor_bests'
                      : 'bests';

        classes.forEach(function(cls) {
            scope.querySelectorAll('.' + cls).forEach(function(el) {
                el.style.display = cls === showClass ? '' : 'none';
            });
        });
    }
</script>


