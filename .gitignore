
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Planner-generated bead validation schemas: regenerated per bead from the planner session.
.beads/schemas/

# Build and run artifacts: the Rust target trees and the census store/export roots
/target/
/fuzz/target/
/mutants.out/
/mutants.out.old/
/var/

# Huge regenerable trees that must not enter the object store: the scraped external reference dump
# and its search index (local/restate-docs alone is a gigabyte), plus fuzz corpora and artifacts.
# docs/VERIFICATION-EVIDENCE.md already documents the corpus as gitignored.
/local/
/fuzz/corpus/
/fuzz/artifacts/

/.moon/cache/
/tools/build-toolchain.json
/tools/.build-toolchain.*

# Stray CARGO_TARGET_DIR trees under a crate (the root /target/ rule does not reach them).
/crates/*/target/

# Coach tap evidence: 2.1 GB of per-probe HTTP captures and 319 MB of derived extracts that
# TAP-REGISTRY.json references by relative path. The plan, registry, matrices and datasets beside
# them stay tracked; these two trees stay on disk and out of the object store.
/research/sources/coach-coverage-bundle-20261004/probes/
/research/sources/coach-coverage-bundle-20261004/extract/
