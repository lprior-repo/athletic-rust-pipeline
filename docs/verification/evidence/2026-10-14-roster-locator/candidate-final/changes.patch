+fn check_rejected_between_positive_rows(
+    inner: &str,
+    kind: RosterRejectionKind,
+    athlete_id: Option<&str>,
+) -> TestResult {
+    let positive = row(INNER);
+    let middle = row(inner);
+    let body = format!("{PREFIX}{positive}{middle}{positive}</ul>");
+    let RosterVerdict::Partial {
+        roster,
+        rejected,
+        unfinished,
+    } = parse_roster(&body, team()?)?
+    else {
+        return Err("oversized middle row must preserve both positive occurrences".into());
+    };
+    let [first, last] = roster.athletes.as_slice() else {
+        return Err("expected two positive rows".into());
+    };
+    let [rejection] = rejected.as_slice() else {
+        return Err("expected one rejection".into());
+    };
+    check!(eq; unfinished, None);
+    let first_offset = PREFIX.len().checked_add(OPEN.len()).ok_or("first offset")?;
+    let rejected_offset = first_offset
+        .checked_add(positive.len())
+        .ok_or("rejected offset")?;
+    let last_offset = rejected_offset
+        .checked_add(middle.len())
+        .ok_or("last offset")?;
+    check_member(&body, first, 0, first_offset, INNER)?;
+    check_member(&body, last, 2, last_offset, INNER)?;
+    check!(eq; rejection.row, SourceRowLocator { ordinal: 1, byte_offset: rejected_offset, byte_length: inner.len() });
+    check!(eq; rejection.kind, kind);
+    check!(eq; rejection.athlete_id.as_deref(), athlete_id);
+    check!(eq; span(&body, rejection.row)?, inner);
+    Ok(())
+}
+
+#[test]
+fn positive_roster_row_byte_boundary_preserves_the_following_locator() -> TestResult {
+    let padding = 65_536usize
+        .checked_sub(INNER.len())
+        .ok_or("fixture row size")?;
+    let exact = format!("{INNER}{}", "x".repeat(padding));
+    let body = format!("{PREFIX}{}</ul>", row(&exact));
+    let RosterVerdict::Complete { roster } = parse_roster(&body, team()?)? else {
+        return Err("exact 64 KiB inner row must remain readable".into());
+    };
+    check!(eq; roster.athletes.len(), 1);
+    check_member(
+        &body,
+        roster.athletes.first().ok_or("missing boundary row")?,
+        0,
+        PREFIX
+            .len()
+            .checked_add(OPEN.len())
+            .ok_or("boundary offset")?,
+        &exact,
+    )?;
+    check_rejected_between_positive_rows(
+        &format!("{exact}x"),
+        RosterRejectionKind::RowTooLarge,
+        None,
+    )
+}
+
+#[test]
+fn positive_roster_field_limits_preserve_bounded_rejection_identity_and_positions() -> TestResult {
+    let long_name = INNER
+        .replace("D&apos;Arc, José", &"N".repeat(4097))
+        .replace("/42-example", "/99-example");
+    check_rejected_between_positive_rows(
+        &long_name,
+        RosterRejectionKind::FieldTooLarge,
+        Some("99"),
+    )?;
+    let long_id = INNER.replace("/42-example", &format!("/{}-example", "9".repeat(4097)));
+    check_rejected_between_positive_rows(&long_id, RosterRejectionKind::FieldTooLarge, None)
+}
