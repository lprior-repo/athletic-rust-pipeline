[Unit]
Description=Run the Midwest census incremental refresh weekly

[Timer]
# Sunday 03:17 local; the jitter keeps the forty-nine jurisdiction walks from aligning with other
# cron work.
OnCalendar=Sun *-*-* 03:17:00
RandomizedDelaySec=900
Persistent=true
Unit=census-service-collect.service

[Install]
WantedBy=timers.target
