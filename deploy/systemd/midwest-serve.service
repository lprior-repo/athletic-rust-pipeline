[Unit]
Description=Midwest census Restate endpoint (midwest-serve)
Documentation=file:/opt/athletic-rust-pipeline/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=midwest
Group=midwest
WorkingDirectory=/opt/athletic-rust-pipeline
Environment=RUST_LOG=info
# Restart is deliberately conservative: the endpoint is journaled by Restate, so a crash resumes at
# the last recorded step and the drain certificate is printed on a clean SIGTERM.
ExecStart=/opt/athletic-rust-pipeline/target/release/midwest-serve \
  --listen 127.0.0.1:9080 \
  --data-dir /var/lib/midwest-census \
  --max-concurrent 8 \
  --drain-timeout 30
Restart=on-failure
RestartSec=5
# SIGTERM starts the drain (accept no new work, finish in-flight, write the drain certificate).
# TimeoutStopSec must exceed --drain-timeout or systemd SIGKILLs mid-drain and the certificate is lost.
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/midwest-census
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
