[Unit]
Description=Midwest census Restate endpoint (%i)
Documentation=file:/opt/athletic-rust-pipeline/docs/OPERATIONS.md
After=network-online.target restate-server.service
Wants=network-online.target
Requires=restate-server.service

[Service]
Type=simple
User=midwest
Group=midwest
# %i is the release identity: the short commit being served. Each release gets its own binary, its
# own store directory and its own log directory, so `census-serve@abc1234` and the next release
# cannot hold one another's Fjall writer lock. Rolling forward means starting a second instance and
# retiring the first; rolling back means starting the previous instance again, and both are visible
# as separate deployments in the node's admin API.
WorkingDirectory=/opt/athletic-rust-pipeline/releases/%i
Environment=RUST_LOG=info
# CENSUS_LISTEN is the only value that differs between releases besides %i itself; see
# deploy/endpoint.env.example.
EnvironmentFile=/etc/census-service/endpoint-%i.env
ExecStart=/opt/athletic-rust-pipeline/releases/%i/bin/census-serve \
  --listen ${CENSUS_LISTEN} \
  --data-dir /var/lib/census-service/%i \
  --max-concurrent 8 \
  --drain-timeout 30
Restart=on-failure
RestartSec=5
# The endpoint is journaled by the node, so a crash resumes at the last recorded step and the drain
# certificate is printed on a clean SIGTERM. TimeoutStopSec must exceed --drain-timeout or systemd
# SIGKILLs mid-drain and the certificate is lost.
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=append:/var/log/census-service/%i/serve.log
StandardError=append:/var/log/census-service/%i/serve.err.log
StateDirectory=census-service/%i
LogsDirectory=census-service/%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/census-service/%i
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
