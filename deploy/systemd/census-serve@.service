[Unit]
Description=Midwest census Restate endpoint (%i)
Documentation=file:/opt/athletic-rust-pipeline/docs/OPERATIONS.md
After=network-online.target restate-server.service
Wants=network-online.target
Requires=restate-server.service

[Service]
Type=simple
Slice=census.slice
User=midwest
Group=midwest
# %i selects immutable binary/log artifacts, not a new logical census.
# Initialize a separately authorized fresh root before starting this unit.
# Same-run handoff requires a stopped-owner override preserving the original root.
WorkingDirectory=/opt/athletic-rust-pipeline/releases/%i
Environment=RUST_LOG=info
# CENSUS_LISTEN is the only value that differs between releases besides %i itself; see
# deploy/endpoint.env.example.
EnvironmentFile=/etc/census-service/endpoint-%i.env
ExecStart=/opt/athletic-rust-pipeline/releases/%i/bin/census-serve \
  --listen ${CENSUS_LISTEN} \
  --data-dir /var/lib/census-service/%i \
  --capture-protocol fresh-qualification-v3 \
  --max-concurrent 8 \
  --drain-timeout 30 \
  --memory-budget-gib 48 \
  --memory-cgroup /census.slice
Restart=on-failure
RestartSec=5
# The deadline is an async grace period. Started blocking effects must finish before the store
# is flushed and the drain certificate is emitted; a service-manager timeout must not kill them.
KillSignal=SIGTERM
TimeoutStopSec=infinity
SendSIGKILL=no
StandardOutput=append:/var/log/census-service/%i/serve.log
StandardError=append:/var/log/census-service/%i/serve.err.log
StateDirectory=census-service/%i
LogsDirectory=census-service/%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/census-service/%i
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
