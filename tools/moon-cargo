#!/usr/bin/env bash
set -euo pipefail
: "${MOON_RUST_CARGO:?Run through tools/moon-local to select and fingerprint Cargo}"
if [[ ${MOON_RUST_BUILD_JOBS+x} ]]; then
  if [[ ! "$MOON_RUST_BUILD_JOBS" =~ ^[123456789][0123456789]*$ ]]; then
    printf 'tools/moon-cargo: MOON_RUST_BUILD_JOBS must be a positive decimal integer without leading zeros\n' >&2
    exit 2
  fi
  export CARGO_BUILD_JOBS="$MOON_RUST_BUILD_JOBS"
fi
if [[ ${MOON_RUST_SCOPED_TEST_FEATURES+x} ]]; then
  case "$MOON_RUST_SCOPED_TEST_FEATURES" in
    all|default) ;;
    *)
      printf 'tools/moon-cargo: MOON_RUST_SCOPED_TEST_FEATURES must be all or default\n' >&2
      exit 2
      ;;
  esac
  if [[ ${MOON_TARGET:-} != pipeline:tests-scoped || $# -lt 9 ||
        ${1:-} != nextest || ${2:-} != run || ${3:-} != --config ||
        ${4:-} != .cargo/fast-iteration.toml || ${5:-} != --all-features ||
        ${6:-} != --locked || ${7:-} != --offline ||
        ${8:-} != --no-fail-fast || ${9:-} != --test-threads=16 ]]; then
    printf 'tools/moon-cargo: scoped test feature mode requires the canonical pipeline:tests-scoped prefix\n' >&2
    exit 2
  fi
  if [[ $MOON_RUST_SCOPED_TEST_FEATURES == default ]]; then
    for argument in "${@:10}"; do
      case "$argument" in
        --all-features|--all-features=*|--features|--features=*|-F*|--no-default-features|--no-default-features=*)
          printf 'tools/moon-cargo: default scoped mode refuses conflicting feature flag: %s\n' "$argument" >&2
          exit 2
          ;;
      esac
    done
  fi
fi
if [[ ${MOON_RUST_TEST_THREADS+x} ]]; then
  case "$MOON_RUST_TEST_THREADS" in
    [123456789]|1[0123456]) ;;
    *)
      printf 'tools/moon-cargo: MOON_RUST_TEST_THREADS must be a decimal integer from 1 through 16 without leading zeros\n' >&2
      exit 2
      ;;
  esac
  canonical_prefix=(nextest run --config .cargo/fast-iteration.toml)
  case "${MOON_TARGET:-}" in
    pipeline:tests-scoped) ;;
    pipeline:tests) canonical_prefix+=(--workspace) ;;
    pipeline:report-test) canonical_prefix+=(-p census-report --lib) ;;
    *)
      printf 'tools/moon-cargo: test thread override requires pipeline:tests, pipeline:report-test or pipeline:tests-scoped\n' >&2
      exit 2
      ;;
  esac
  canonical_prefix+=(--all-features --locked --offline --no-fail-fast --test-threads=16)
  arguments=("$@")
  for index in "${!canonical_prefix[@]}"; do
    if [[ ${arguments[index]-} != "${canonical_prefix[index]}" ]]; then
      printf 'tools/moon-cargo: test thread override requires the canonical %s prefix\n' "$MOON_TARGET" >&2
      exit 2
    fi
  done
  thread_position=${#canonical_prefix[@]}
  for argument in "${@:$((thread_position + 1))}"; do
    case "$argument" in
      --test-threads|--test-threads=*|--jobs|--jobs=*|-j*)
        printf 'tools/moon-cargo: test thread override refuses conflicting thread flag: %s\n' "$argument" >&2
        exit 2
        ;;
    esac
    if [[ "$argument" =~ ^-[vhr]*j ]]; then
      printf 'tools/moon-cargo: test thread override refuses conflicting thread flag: %s\n' "$argument" >&2
      exit 2
    fi
  done
  set -- "${@:1:$((thread_position - 1))}" "--test-threads=$MOON_RUST_TEST_THREADS" "${@:$((thread_position + 1))}"
fi
if [[ ${MOON_RUST_SCOPED_TEST_FEATURES:-} == default ]]; then
  set -- "${@:1:4}" "${@:6}"
fi
exec "$MOON_RUST_CARGO" "$@"
