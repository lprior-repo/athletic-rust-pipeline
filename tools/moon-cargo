#!/usr/bin/env bash
set -euo pipefail
: "${MOON_RUST_CARGO:?Run through tools/moon-local to select and fingerprint Cargo}"
if [[ ${MOON_RUST_BUILD_JOBS+x} ]]; then
  if [[ ! "$MOON_RUST_BUILD_JOBS" =~ ^[123456789][0123456789]*$ ]]; then
    printf 'tools/moon-cargo: MOON_RUST_BUILD_JOBS must be a positive decimal integer without leading zeros\n' >&2
    exit 2
  fi
  export CARGO_BUILD_JOBS="$MOON_RUST_BUILD_JOBS"
fi
exec "$MOON_RUST_CARGO" "$@"
