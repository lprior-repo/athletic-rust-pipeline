   "generator": "python3 - <<'PY'\nimport json, pathlib, sys\nsys.path.insert(0, \"/home/lewis/src/ad-law-scrape/census-prototype\")\nfrom parsers.dragonfly_school import parse as parse_school\nimport run\nbase = pathlib.Path(\"crates/census-crawl/tests/fixtures/coach_directories\")\ngolden = {}\nfor path in sorted(base.glob(\"probe/*/summary-*.json\")) + sorted(base.glob(\"*_staff_summary_*.json\")):\n    parsed = parse_school(path.read_bytes())\n    kept = [c for c in parsed[\"coaches\"] if (c.get(\"level\") or \"Varsity\") == \"Varsity\"]\n    dropped = {}\n    for c in parsed[\"coaches\"]:\n        label = c.get(\"level\") or \"Varsity\"\n        if label != \"Varsity\":\n            dropped[label] = dropped.get(label, 0) + 1\n    parts = path.relative_to(base).parts\n    state = parts[parts.index(\"probe\") + 1] if \"probe\" in parts else (\"NC\" if \"nc_staff\" in path.name else \"IN\")\n    merged = run.merge_state(state, [({\"source_id\": \"detail:\" + path.stem, \"status\": \"ok\"}, parsed[\"schools\"], kept)])\n    school = parsed[\"schools\"][0]\n    golden[str(path.relative_to(base))] = {\n        \"school\": {\"name\": school.get(\"name\", \"\"), \"city\": school.get(\"city\", \"\")},\n        \"school_unslotted\": {f: school.get(f, \"\") for f in (\"address\", \"zip\", \"phone\", \"association_id\")},\n        \"coaches\": [{f: row.get(f, \"\") for f in (\"person\", \"sport\", \"role\", \"gender\", \"email\", \"phone\", \"code\")} for row in merged[\"coach_rows\"]],\n        \"dropped_counts\": dropped,\n    }\nprint(json.dumps(golden, indent=1, sort_keys=True))\nPY",
